# ============================================
#       🥷 ITACHI-XMD — Configuration
# ============================================
# Copiez ce fichier en .env et remplissez vos infos
# cp .env.example .env

# 📞 Votre numéro WhatsApp (sans + et sans espace)
# Exemple: 224621963059
OWNER_NUMBER=224621963059

# 👤 Votre nom (propriétaire du bot)
OWNER_NAME=Ibrahima sory sacko

# 🤖 Nom du bot
BOT_NAME=ITACHI-XMD

# 🔑 Préfixe des commandes (par défaut: .)
PREFIX=.

# 🌍 Mode du bot: public ou private
# public = tout le monde peut utiliser
# private = seulement le propriétaire
COMMAND_MODE=public

# 📺 Lien de votre chaîne YouTube (optionnel)
YT_CHANNEL=

# 📢 Lien de votre chaîne WhatsApp (optionnel)
WA_CHANNEL=

# 🎨 Nom du pack de stickers
PACK_NAME=ITACHI-XMD

# 👨‍💻 Auteur des stickers
PACK_AUTHOR=IBSACKO

# 🔑 Clé API Giphy (pour les GIFs)
GIPHY_API_KEY=qnl7ssQChTdPjsKta2Ax2LMaGXz303tq

# 📌 Version du bot (ne pas modifier)
BOT_VERSION=2.0.0

# 🛡️ Mot de passe du dashboard admin (/admin) — OBLIGATOIRE pour y accéder
ADMIN_PASSWORD=

# 🌐 URL publique de ton bot (fournie automatiquement sur Render).
# Utilisée pour l'auto-ping qui empêche l'hébergeur de mettre le bot en veille.
# Laisse vide si tu ne sais pas, ou mets l'URL de ton service (ex: https://tonbot.onrender.com)
APP_URL=

# 🤖 Clé API Groq (pour .ai, .gpt, .gemini, .codeai, .chatbot, etc.)
# Gratuite sur https://console.groq.com
GROQ_API_KEY=


